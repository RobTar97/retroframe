<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      RetroFrame makes no network requests, and this file is where that is enforced rather
      than merely claimed.

      INTERNET is absent, so the OS will not let the app open a socket even if some future
      change tried to. READ_EXTERNAL_STORAGE is absent too: media is read through the Storage
      Access Framework, which grants exactly the one folder the user picks and nothing else.

      ACCESS_NETWORK_STATE has to be actively removed rather than simply not declared —
      Media3 injects it for adaptive streaming, which this app never does. It grants no
      socket access by itself, but leaving it in would place a network permission in the
      installed app and make the project's claim false on inspection. Check with:
          adb shell dumpsys package com.rober.photoframe
      The installed app should list exactly four permissions.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      SCHEDULE_EXACT_ALARM, singular. This was declared as SCHEDULE_EXACT_ALARMS for a long
      time, which is not a permission that exists — so the system never offered it and the
      morning alarm silently ran on inexact timing on every device. Only the alarm clock
      needs this; the wake/sleep schedule deliberately uses inexact alarms so the tablet can
      stay asleep. Android 12 (API 31) and up only.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- This is a tablet-first app, but nothing requires a large screen. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".PhotoframeApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Photoframe"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Photoframe.Fullscreen"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density">
            <!--
              configChanges: rotating a wall-mounted frame used to destroy and recreate the
              activity, which rescanned the folder, rebuilt the playlist and lost the user's
              place. The layout is a single full-bleed pager, so handling the change here
              costs nothing and keeps the slideshow running.

              showWhenLocked/turnScreenOn: the wake schedule needs to display over the lock
              screen at 07:00, otherwise the user sees a lock screen instead of their photos.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".boot.BootReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Non-standard, but several older vendor ROMs send this instead. -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".schedule.DailySchedule$ScheduleReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rober.photoframe.ACTION_WAKE_UP" />
                <action android:name="com.rober.photoframe.ACTION_SLEEP" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".schedule.AlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.rober.photoframe.ACTION_ALARM" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".schedule.AlarmDismissReceiver"
            android:enabled="true"
            android:exported="false" />

    </application>

</manifest>
