<resources>

    <style name="Theme.Photoframe" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/frame_accent</item>
        <item name="colorPrimaryVariant">@color/frame_accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/frame_accent</item>
        <item name="colorSecondaryVariant">@color/frame_accent_dark</item>
        <item name="colorOnSecondary">@color/black</item>
    </style>

    <!--
      Fullscreen slideshow theme.

      Note there is no android:windowFullscreen here. From API 35 the platform ignores it and
      enforces edge-to-edge, so system bar handling lives entirely in
      MainActivity.applyImmersiveMode() via WindowInsetsControllerCompat. Keeping the
      deprecated attribute as well would only produce two sources of truth that disagree on
      newer devices.

      Transparent bars mean that on the rare occasion the user swipes them into view, they
      float over the photo rather than shifting the layout.
    -->
    <style name="Theme.Photoframe.Fullscreen" parent="Theme.Photoframe">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
